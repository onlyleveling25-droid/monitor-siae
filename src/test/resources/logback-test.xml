<configuration>
    <!-- Las pruebas no escriben en la carpeta de datos del usuario. -->
    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="CONSOLA"/>
    </root>
</configuration>
